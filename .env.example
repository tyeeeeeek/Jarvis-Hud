# Copy this file to .env and fill in your real values.
# .env is gitignored — it never gets committed.

# From dashboard.plaid.com -> Team Settings -> Keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox = fake test data, safe to experiment with
# development / production = real bank data (requires Plaid approval)
PLAID_ENV=sandbox

# --- Text Jarvis (SMS), via Twilio -- see README "Text Jarvis (SMS)" ---
# Your phone -- the only number Jarvis will text or accept commands from.
USER_PHONE_NUMBER=
# From console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Text Jarvis via Telegram instead (free, no card) -- see README
# "Text Jarvis (Telegram)" ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- PC health alerts (JarvisCPU_Alerts) -- see README "PC health alerts
# (JarvisCPU_Alerts)". Dedicated send-only bot, separate from the one above,
# for 2-hourly health check summaries + immediate critical alerts. Leave
# JARVIS_CPU_ALERTS_CHAT_ID blank to reuse TELEGRAM_CHAT_ID. ---
JARVIS_CPU_ALERTS_BOT_TOKEN=
JARVIS_CPU_ALERTS_CHAT_ID=

# --- Watch my email -- see README "Watch my email" ---
# Uncomment only if you want credentials.json/token.json somewhere other
# than this project folder.
# GMAIL_CREDENTIALS_PATH=
# GMAIL_TOKEN_PATH=
