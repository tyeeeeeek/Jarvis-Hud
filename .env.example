# Copy this file to .env and fill in your real values.
# .env is gitignored — it never gets committed.

# From dashboard.plaid.com -> Team Settings -> Keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox = fake test data, safe to experiment with
# development / production = real bank data (requires Plaid approval)
PLAID_ENV=sandbox

# --- Text Jarvis (SMS), via Twilio -- see README "Text Jarvis (SMS)" ---
# Your phone -- the only number Jarvis will text or accept commands from.
USER_PHONE_NUMBER=
# From console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Text Jarvis via Telegram instead (free, no card) -- see README
# "Text Jarvis (Telegram)" ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- PC health alerts (JarvisCPU_Alerts) -- see README "PC health alerts
# (JarvisCPU_Alerts)". Dedicated send-only bot, separate from the one above,
# for 2-hourly health check summaries + immediate critical alerts. Leave
# JARVIS_CPU_ALERTS_CHAT_ID blank to reuse TELEGRAM_CHAT_ID. ---
JARVIS_CPU_ALERTS_BOT_TOKEN=
JARVIS_CPU_ALERTS_CHAT_ID=

# --- Daily self-improvement report (JarvisImprovement) -- see README
# "24/7 self-improvement". Dedicated send-only bot for the once-a-day
# summary of whatever JarvisImprovement's 6 AM / up-to-2-hour pass safely
# added. Leave JARVIS_IMPROVEMENT_CHAT_ID blank to reuse TELEGRAM_CHAT_ID. ---
JARVIS_IMPROVEMENT_BOT_TOKEN=
JARVIS_IMPROVEMENT_CHAT_ID=

# --- Cybersecurity watchdog (JarSecurity) -- see README "Cybersecurity
# watchdog (JarSecurity)". Dedicated send-only bot for the periodic
# open-ports/suspicious-process/LAN-scan sweep, plus immediate alerts on
# anything critical. Leave JARVIS_SECURITY_CHAT_ID blank to reuse
# TELEGRAM_CHAT_ID. ---
JARVIS_SECURITY_BOT_TOKEN=
JARVIS_SECURITY_CHAT_ID=

# --- Approval gate (JarvisAdmin) -- see README "Require approval first
# (JarvisAdmin bot)". Dedicated bot that asks yes/no before a high-consequence
# action runs (currently system_power's shutdown/restart). Leave
# JARVIS_ADMIN_BOT_TOKEN unset to skip approval entirely (shutdown/restart run
# immediately, as before). Leave JARVIS_ADMIN_CHAT_ID blank to reuse
# TELEGRAM_CHAT_ID. ---
JARVIS_ADMIN_BOT_TOKEN=
JARVIS_ADMIN_CHAT_ID=
JARVIS_ADMIN_APPROVAL_TIMEOUT_SECONDS=180

# --- JarvisEmail bot -- a dedicated two-way Telegram bot for real, open-
# ended Gmail/Outlook mail and calendar Q&A and actions ("what's in my
# inbox", "read that email", "what's on my calendar", "move my 3pm to
# 4pm"). Routes through the same full brain as the main Telegram bridge --
# see jarvis_email_bot.py. Leave JARVIS_EMAIL_CHAT_ID blank to reuse
# TELEGRAM_CHAT_ID. ---
JARVIS_EMAIL_BOT_TOKEN=
JARVIS_EMAIL_CHAT_ID=

# --- JarvisOutlook bot -- same setup as JarvisEmail above, its own
# dedicated bot/chat channel into the same full brain. ---
JARVIS_OUTLOOK_BOT_TOKEN=
JARVIS_OUTLOOK_CHAT_ID=

# --- Email + calendar (Gmail) -- see README "Connect email + calendar" ---
# Uncomment only if you want credentials.json/token.json somewhere other
# than this project folder. No token needed here beyond that file --
# GMAIL_CREDENTIALS_PATH points at the OAuth client JSON from Google Cloud
# Console, GMAIL_TOKEN_PATH is where the cached user consent is stored.
# GMAIL_CREDENTIALS_PATH=
# GMAIL_TOKEN_PATH=

# --- Email + calendar (Outlook) -- see README "Connect email + calendar" ---
# OUTLOOK_CLIENT_ID is the Application (client) ID from your Azure AD app
# registration (App registrations -> New registration -> "Accounts in any
# organizational directory and personal Microsoft accounts", then enable
# "Allow public client flows" under Authentication). No client secret is
# used -- this is a public client, device-code login only. Leave
# OUTLOOK_TENANT_ID unset to default to "common" (personal + work/school
# accounts); OUTLOOK_TOKEN_PATH defaults to token_outlook.json in this
# project folder.
OUTLOOK_CLIENT_ID=
# OUTLOOK_TENANT_ID=
# OUTLOOK_TOKEN_PATH=

# --- Homelab: Synology NAS status + folder sync -- see README "Homelab (NAS
# + network)". Create a DEDICATED DSM user for this (DSM > Control Panel >
# User & Group > Create), not your admin account -- it needs read access for
# status, and read/write access to whichever shared folder SYNOLOGY_BASE_PATH
# points at (create that shared folder first and grant this user permission
# on it). Works with either the NAS's LAN IP or its Tailscale IP (100.x.x.x)
# if this PC and the NAS are both on your tailnet.
SYNOLOGY_HOST=
SYNOLOGY_PORT=5001
SYNOLOGY_USER=
SYNOLOGY_PASSWORD=
# NAS-side folder that export_folder_to_nas/import_folder_from_nas/
# list_nas_folder/sync_bank_data are jailed to -- e.g. a shared folder named
# "JarvisSync" with a "Bank Statements" subfolder inside it. Never touches
# anything on the NAS outside this folder.
SYNOLOGY_BASE_PATH=/JarvisSync

# --- Homelab: Pi-hole ad/tracker-blocking stats, folded into JarSecurity's
# periodic sweep (see jarvis_security.py) and check_pihole_status(). Read-
# only -- never toggles blocking or touches Pi-hole's config. Generate an
# App Password in Pi-hole (Settings -> API / Web interface -> App Password),
# NOT your admin login password, and paste it below. Set PIHOLE_URL to your
# Pi-hole's LAN or Tailscale address (e.g. http://192.168.1.5); leave both
# blank to skip Pi-hole checks entirely.
PIHOLE_URL=
PIHOLE_APP_PASSWORD=

# --- Fleet: remote control of other machines on your tailnet -- see
# fleet_service.py's module docstring for full setup steps per device.
# Four fixed, optional slots: "nas" (Linux, e.g. a Synology NAS) and
# "pc1"/"pc2"/"pc3" (Windows). All use a normal OpenSSH server reached over
# Tailscale (Synology's own Tailscale package doesn't support Tailscale's
# own SSH server), authenticated with a dedicated keypair Jarvis generates
# at ~/.jarvis/ssh/fleet_key -- add fleet_key.pub to that device's
# authorized_keys, then set its tailnet hostname and username here. Leave
# a slot's HOST/USER blank if you don't have that device -- Jarvis will
# say so instead of failing oddly.
FLEET_NAS_HOST=
FLEET_NAS_USER=
FLEET_PC1_HOST=
FLEET_PC1_USER=
FLEET_PC2_HOST=
FLEET_PC2_USER=
FLEET_PC3_HOST=
FLEET_PC3_USER=

# --- Fleet: Wake-on-LAN -- separate from the SSH usernames above (waking a
# device needs no SSH, since the whole point is reaching one that's off).
# Set to that device's WIRED Ethernet adapter's MAC address (Wi-Fi
# Wake-on-LAN is unreliable/often unsupported) -- Windows: `Get-NetAdapter`;
# Linux: `ip link`. Also needs Wake-on-LAN enabled in that device's BIOS and
# NIC power settings -- see fleet_service.py's module docstring for the
# exact steps. Leave blank for any device you haven't set this up on.
FLEET_NAS_MAC=
FLEET_PC1_MAC=
FLEET_PC2_MAC=
FLEET_PC3_MAC=

# --- Homelab: new-device alerts on your LAN -- see README. Requires nmap
# installed (sudo apt install nmap). Leave blank to auto-detect the subnet
# from this PC's default route; only set this if that guess is wrong for
# your network (e.g. it's not a /24).
LAN_SUBNET_OVERRIDE=

# --- Phone HUD camera Q&A -- see README "Phone HUD (camera Q&A)".
# REQUIRED for the phone HUD's camera to actually answer questions about
# what it sees (Gemini vision -- see _GEMINI_MODEL in vision_service.py
# for exactly which model). Without this, the HUD's camera
# still opens and shows live local bounding boxes (TensorFlow.js, runs
# entirely in the browser), but asking it a question gets an honest
# "vision isn't configured yet" instead of a real answer -- there is
# deliberately no fake/local-only guess for open-ended questions. Get a
# free key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# --- Fast cloud fallback brain (Groq) -- tried when the main Claude brain
# fails (offline, not authenticated, claude.exe missing), before dropping
# to the fully-offline local Ollama model. See ask_groq in jarvis.py and
# _ask_groq in telegram_common.py. Without this, that middle tier is
# skipped and Jarvis falls straight to Ollama, same as before. Free key at
# https://console.groq.com/keys.
GROQ_API_KEY=

# --- Phone dashboard -- see README "Phone dashboard". Requires Tailscale
# connected on this machine; leave blank and a token is generated
# automatically on first run (cat ~/.jarvis/dashboard_token.txt to see it).
# Only set this yourself if you want to pick your own token.
DASHBOARD_TOKEN=

# --- Desktop HUD's Map page (see src/components/MapWidget.tsx). Optional --
# free key, no card required -- sign up at https://www.maptiler.com/cloud/
# and copy the key from your account dashboard for MapTiler's sharper
# "dataviz-dark" vector style. Without this, the map already uses a real
# dark vector style by default (OpenFreeMap's free, keyless "dark" style --
# https://openfreemap.org), just from a different provider -- this key only
# switches which one. Must be prefixed VITE_ (not just MAPTILER_KEY) -- Vite
# only exposes env vars with that prefix to frontend code.
VITE_MAPTILER_KEY=

# --- Same Map page's "STREET VIEW" button (Mapillary street-level photos).
# Free, no card required -- sign up at https://www.mapillary.com, then
# create a "developer application" at https://www.mapillary.com/dashboard/developers
# and copy its client token. Without this, the STREET VIEW button shows a
# setup message instead of failing silently.
VITE_MAPILLARY_TOKEN=
