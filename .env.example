# Copy this file to .env and fill in what you need. Every value below is
# optional -- Jarvis runs fully offline-capable without any of them (Claude
# Code CLI is the real brain; Groq/Ollama are just fallbacks), and the map
# widget works with no keys at all using free, no-signup providers.

# --- Groq: fast cloud fallback if the Claude Code CLI can't be reached
# (chit-chat only, no tool access) -- get a free key at console.groq.com/keys.
# Leave blank to skip straight to the local Ollama fallback instead.
GROQ_API_KEY=

# --- Map widget: MapTiler gives a nicer vector basemap style than the
# default (OpenFreeMap, which needs no key at all) -- free tier at
# maptiler.com. Frontend env vars need the VITE_ prefix to reach the
# browser; leave blank to just use the default style.
VITE_MAPTILER_KEY=

# --- Map widget: Mapillary powers the optional street-view button -- free
# account (no billing/card) at mapillary.com. Leave blank and the button
# still appears, it just explains what to do instead of failing silently.
VITE_MAPILLARY_TOKEN=
